<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar / avatar glyph for Call Reminder notifications.
     A single white silhouette on transparent, per Android's notification
     icon convention — Android tints this automatically (status bar,
     colorized card, Person avatar), so it must stay a plain shape with no
     fill color baked in beyond white. Using the full-color app launcher
     icon here (the previous approach) renders as a muddy gray blob in the
     status bar, since Android force-flattens non-monochrome icons to their
     alpha channel there. -->
